            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "b5826ce3",
      "displayName": "TOP10",
      "queryLines": [
        "SELECT *\r\n",
        "FROM gold_vitorias_piloto\r\n",
        "ORDER BY vitorias DESC\r\n",
        "LIMIT 10"
      ],
      "catalog": "dataops_learn",
      "schema": "f1"
    },
    {
      "name": "0665382b",
      "displayName": "gold_posicoes_ganhas",
      "config": {
        "version": "1.1",
        "source": "dataops_learn.f1.gold_posicoes_ganhas",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "e5fa3b7b",
      "displayName": "Top Ten Winners By Positions Achieved Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    full_name,\r\n",
        "    SUM(posicoes_ganhas) AS total_posicoes_ganhas\r\n",
        "FROM gold_posicoes_ganhas\r\n",
        "GROUP BY full_name\r\n",
        "ORDER BY total_posicoes_ganhas DESC\r\n",
        "LIMIT 10;"
      ],
      "catalog": "dataops_learn",
      "schema": "f1"
    },
    {
      "name": "53a0f528",
      "displayName": "Season Race Points Overview Dataset",
      "queryLines": [
        "select season, corridas, pontos\r\n",
        "from dataops_learn.f1.gold_pontos_temporada\r\n",
        "order by season"
      ]
    }
  ],
